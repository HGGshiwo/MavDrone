<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mavdrone_ros</name>
  <version>0.1.0</version>
  <description>Contains the nodes to launch the mavdrone connection, a local grid broadcaster and a
    goal pose server to send RVIZ navigation goals to mavdrone.</description>
  <maintainer email="rick.vanessen@wur.nl">Rick van Essen</maintainer>
  <license>AGPL-3.0-or-later</license>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-transforms3d</exec_depend>
  <exec_depend>python3-utm</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>camera_info_manager_py</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_satellite</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>mavdrone_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>