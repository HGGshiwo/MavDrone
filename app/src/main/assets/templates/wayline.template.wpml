<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns:wpml="http://www.dji.com/wpmz/1.0.2" xmlns="http://www.opengis.net/kml/2.2">
    <Document>
        <!-- Step 1: Setup Mission Configuration -->
        <wpml:missionConfig>
            <wpml:flyToWaylineMode>safely</wpml:flyToWaylineMode>
            <wpml:finishAction>{{finishAction}}</wpml:finishAction>
            <wpml:exitOnRCLost>goContinue</wpml:exitOnRCLost>
            <wpml:executeRCLostAction>hover</wpml:executeRCLostAction>
            <wpml:takeOffSecurityHeight>20</wpml:takeOffSecurityHeight>
            <wpml:globalTransitionalSpeed>10</wpml:globalTransitionalSpeed>
            <wpml:droneInfo>
                <wpml:droneEnumValue>{{droneEnumValue}}</wpml:droneEnumValue>
                <wpml:droneSubEnumValue>{{droneEnumSubValue}}</wpml:droneSubEnumValue>
            </wpml:droneInfo>
            {{#payloads}}
            <wpml:payloadInfo>
                <wpml:payloadEnumValue>{{payloadEnumValue}}</wpml:payloadEnumValue>
                <wpml:payloadSubEnumValue>{{payloadEnumSubValue}}</wpml:payloadSubEnumValue>
                <wpml:payloadPositionIndex>{{payloadPositionIndex}}</wpml:payloadPositionIndex>
            </wpml:payloadInfo>
            {{/payloads}}
        </wpml:missionConfig>

        <!-- Step 2: Setup A Folder for Waypoint Template -->
        <Folder>
            <wpml:templateId>0</wpml:templateId>
            <wpml:executeHeightMode>relativeToStartPoint</wpml:executeHeightMode>
            <wpml:waylineId>0</wpml:waylineId>
            <wpml:autoFlightSpeed>{{autoFlightSpeed}}</wpml:autoFlightSpeed>
            {{#hasStartActions}}
            <wpml:startActionGroup>
                {{#startActions}}
                <wpml:action>
                    <wpml:actionId>{{actionId}}</wpml:actionId>
                    <wpml:actionActuatorFunc>{{actionName}}</wpml:actionActuatorFunc>
                    <wpml:actionActuatorFuncParam>
                        {{#isStartRecordAction}}
                        <wpml:payloadPositionIndex>{{actionPayloadPositionIndex}}</wpml:payloadPositionIndex>
                        <wpml:fileSuffix>{{actionFileSuffix}}</wpml:fileSuffix>
                        <wpml:payloadLensIndex>{{actionPayloadLensIndex}}</wpml:payloadLensIndex>
                        <wpml:useGlobalPayloadLensIndex>0</wpml:useGlobalPayloadLensIndex>
                        {{/isStartRecordAction}}
                        {{#isStopRecordAction}}
                        <wpml:payloadPositionIndex>{{actionPayloadPositionIndex}}</wpml:payloadPositionIndex>
                        <wpml:payloadLensIndex>{{actionPayloadLensIndex}}</wpml:payloadLensIndex>
                        {{/isStopRecordAction}}
                        {{#isFocusAction}}
                        <wpml:payloadPositionIndex>{{actionPayloadPositionIndex}}</wpml:payloadPositionIndex>
                        <wpml:isPointFocus>{{actionIsPointFocus}}</wpml:isPointFocus>
                        <wpml:focusX>{{actionFocusX}}</wpml:focusX>
                        <wpml:focusY>{{actionFocusY}}</wpml:focusY>
                        <wpml:focusRegionWidth>{{actionFocusRegionWidth}}</wpml:focusRegionWidth>
                        <wpml:focusRegionHeight>{{actionFocusRegionHeight}}</wpml:focusRegionHeight>
                        <wpml:isInfiniteFocus>{{actionIsInfiniteFocus}}</wpml:isInfiniteFocus>
                        {{/isFocusAction}}
                        {{#isZoomAction}}
                        <wpml:payloadPositionIndex>{{actionPayloadPositionIndex}}</wpml:payloadPositionIndex>
                        <wpml:focalLength>{{actionFocalLength}}</wpml:focalLength>
                        {{/isZoomAction}}
                        {{#isCustomDirAction}}
                        <wpml:payloadPositionIndex>{{actionPayloadPositionIndex}}</wpml:payloadPositionIndex>
                        <wpml:directoryName>{{actionDirectoryName}}</wpml:directoryName>
                        {{/isCustomDirAction}}
                        {{#isGimbalRotateAction}}
                        <wpml:payloadPositionIndex>{{actionPayloadPositionIndex}}</wpml:payloadPositionIndex>
                        <wpml:gimbalHeadingYawBase>{{actionGimbalHeadingYawBase}}</wpml:gimbalHeadingYawBase>
                        <wpml:gimbalRotateMode>{{actionGimbalRotateMode}}</wpml:gimbalRotateMode>
                        <wpml:gimbalPitchRotateEnable>{{actionGimbalPitchRotateEnable}}</wpml:gimbalPitchRotateEnable>
                        <wpml:gimbalPitchRotateAngle>{{actionGimbalPitchRotateAngle}}</wpml:gimbalPitchRotateAngle>
                        <wpml:gimbalRollRotateEnable>{{actionGimbalRollRotateEnable}}</wpml:gimbalRollRotateEnable>
                        <wpml:gimbalRollRotateAngle>{{actionGimbalRollRotateAngle}}</wpml:gimbalRollRotateAngle>
                        <wpml:gimbalYawRotateEnable>{{actionGimbalYawRotateEnable}}</wpml:gimbalYawRotateEnable>
                        <wpml:gimbalYawRotateAngle>{{actionGimbalYawRotateAngle}}</wpml:gimbalYawRotateAngle>
                        <wpml:gimbalRotateTimeEnable>{{actionGimbalRotateTimeEnable}}</wpml:gimbalRotateTimeEnable>
                        <wpml:gimbalRotateTime>{{actionGimbalRotateTime}}</wpml:gimbalRotateTime>
                        {{/isGimbalRotateAction}}
                        {{#isGimbalEvenlyRotateAction}}
                        <wpml:payloadPositionIndex>{{actionPayloadPositionIndex}}</wpml:payloadPositionIndex>
                        <wpml:gimbalPitchRotateAngle>{{actionGimbalPitchRotateAngle}}</wpml:gimbalPitchRotateAngle>
                        {{/isGimbalEvenlyRotateAction}}
                        {{#isRotateYawAction}}
                        <wpml:aircraftHeading>{{actionAircraftHeading}}</wpml:aircraftHeading>
                        <wpml:aircraftPathMode>{{actionAircraftPathMode}}</wpml:aircraftPathMode>
                        {{/isRotateYawAction}}
                        {{#isHoverAction}}
                        <wpml:hoverTime>{{actionHoverTime>}}</wpml:hoverTime>
                        {{/isHoverAction}}
                    </wpml:actionActuatorFuncParam>
                </wpml:action>
                {{/startActions}}
            </wpml:startActionGroup>
            {{/hasStartActions}}

            {{#waypoints}}
            <Placemark>
                <Point>
                    <coordinates>
                        {{waypointCoordinates}}
                    </coordinates>
                </Point>
                <wpml:index>{{waypointIndex}}</wpml:index>
                <wpml:executeHeight>{{waypointAltitude}}</wpml:executeHeight>
                {{#waypointUsesGlobalSpeed}}
                <wpml:useGlobalSpeed>1</wpml:useGlobalSpeed>
                {{/waypointUsesGlobalSpeed}}
                {{^waypointUsesGlobalSpeed}}
                <wpml:useGlobalSpeed>0</wpml:useGlobalSpeed>
                <wpml:waypointSpeed>{{waypointSpeed}}</wpml:waypointSpeed>
                {{/waypointUsesGlobalSpeed}}
                {{#waypointHeadingCustom}}
                <wpml:waypointHeadingParam>
                    <wpml:waypointHeadingMode>{{waypointHeadingMode}}</wpml:waypointHeadingMode>
                    <wpml:waypointHeadingAngle>{{waypointHeadingAngle}}</wpml:waypointHeadingAngle>
                    <wpml:waypointHeadingAngleEnable>{{waypointHeadingAngleEnable}}</wpml:waypointHeadingAngleEnable>
                    <wpml:waypointPoiPoint>0.000000,0.000000,1.000000</wpml:waypointPoiPoint>
                    <wpml:waypointHeadingPathMode>followBadArc</wpml:waypointHeadingPathMode>
                    <wpml:waypointHeadingPoiIndex>0</wpml:waypointHeadingPoiIndex>
                </wpml:waypointHeadingParam>
                {{/waypointHeadingCustom}}
                {{^waypointHeadingCustom}}
                <wpml:waypointHeadingParam>
                    <wpml:waypointHeadingMode>followWayline</wpml:waypointHeadingMode>
                </wpml:waypointHeadingParam>
                {{/waypointHeadingCustom}}
                {{#waypointTurnCustom}}
                <wpml:waypointTurnParam>
                    <wpml:waypointTurnMode>{{waypointTurnMode}}</wpml:waypointTurnMode>
                    <wpml:waypointTurnDampingDist>{{waypointTurnDampingDist}}</wpml:waypointTurnDampingDist>
                </wpml:waypointTurnParam>
                {{/waypointTurnCustom}}
                {{^waypointTurnCustom}}
                <wpml:waypointTurnParam>
                    <wpml:waypointTurnMode>toPointAndStopWithDiscontinuityCurvature</wpml:waypointTurnMode>
                    <wpml:waypointTurnDampingDist>0</wpml:waypointTurnDampingDist>
                </wpml:waypointTurnParam>
                {{/waypointTurnCustom}}
                <wpml:useStraightLine>{{waypointUseStraightLine}}</wpml:useStraightLine>
                <wpml:waypointGimbalHeadingParam>
                    <wpml:waypointGimbalPitchAngle>0</wpml:waypointGimbalPitchAngle>
                    <wpml:waypointGimbalYawAngle>0</wpml:waypointGimbalYawAngle>
                </wpml:waypointGimbalHeadingParam>
                <wpml:isRisky>0</wpml:isRisky>
                <wpml:waypointWorkType>0</wpml:waypointWorkType>

                {{#waypointActionGroups}}
                <wpml:actionGroup>
                    <wpml:actionGroupId>{{actionGroupId}}</wpml:actionGroupId>
                    <wpml:actionGroupStartIndex>{{actionGroupStartIndex}}</wpml:actionGroupStartIndex>
                    <wpml:actionGroupEndIndex>{{actionGroupEndIndex}}</wpml:actionGroupEndIndex>
                    <wpml:actionGroupMode>sequence</wpml:actionGroupMode>
                    <wpml:actionTrigger>
                        <wpml:actionTriggerType>{{actionGroupTriggerType}}</wpml:actionTriggerType>
                        {{#actionGroupTriggerHasParam}}
                        <wpml:actionTriggerParam>{{actionGroupTriggerParam}}</wpml:actionTriggerParam>
                        {{/actionGroupTriggerHasParam}}

                    </wpml:actionTrigger>
                    {{#actionGroupActions}}
                    <wpml:action>
                        <wpml:actionId>{{actionId}}</wpml:actionId>
                        <wpml:actionActuatorFunc>{{actionName}}</wpml:actionActuatorFunc>
                        <wpml:actionActuatorFuncParam>
                            {{#isStartRecordAction}}
                            <wpml:payloadPositionIndex>{{actionPayloadPositionIndex}}</wpml:payloadPositionIndex>
                            <wpml:fileSuffix>{{actionFileSuffix}}</wpml:fileSuffix>
                            <wpml:payloadLensIndex>{{actionPayloadLensIndex}}</wpml:payloadLensIndex>
                            <wpml:useGlobalPayloadLensIndex>0</wpml:useGlobalPayloadLensIndex>
                            {{/isStartRecordAction}}
                            {{#isStopRecordAction}}
                            <wpml:payloadPositionIndex>{{actionPayloadPositionIndex}}</wpml:payloadPositionIndex>
                            <wpml:payloadLensIndex>{{actionPayloadLensIndex}}</wpml:payloadLensIndex>
                            {{/isStopRecordAction}}
                            {{#isSetFocusAction}}
                            <wpml:payloadPositionIndex>{{actionPayloadPositionIndex}}</wpml:payloadPositionIndex>
                            <wpml:cameraFocusType>{{actionCameraFocusType}}</wpml:cameraFocusType>
                            {{/isSetFocusAction}}
                            {{#isFocusAction}}
                            <wpml:payloadPositionIndex>{{actionPayloadPositionIndex}}</wpml:payloadPositionIndex>
                            <wpml:isPointFocus>{{actionIsPointFocus}}</wpml:isPointFocus>
                            <wpml:focusX>{{actionFocusX}}</wpml:focusX>
                            <wpml:focusY>{{actionFocusY}}</wpml:focusY>
                            <wpml:focusRegionWidth>{{actionFocusRegionWidth}}</wpml:focusRegionWidth>
                            <wpml:focusRegionHeight>{{actionFocusRegionHeight}}</wpml:focusRegionHeight>
                            <wpml:isInfiniteFocus>{{actionIsInfiniteFocus}}</wpml:isInfiniteFocus>
                            {{/isFocusAction}}
                            {{#isZoomAction}}
                            <wpml:payloadPositionIndex>{{actionPayloadPositionIndex}}</wpml:payloadPositionIndex>
                            <wpml:focalLength>{{actionFocalLength}}</wpml:focalLength>
                            {{/isZoomAction}}
                            {{#isCustomDirAction}}
                            <wpml:payloadPositionIndex>{{actionPayloadPositionIndex}}</wpml:payloadPositionIndex>
                            <wpml:directoryName>{{actionDirectoryName}}</wpml:directoryName>
                            {{/isCustomDirAction}}
                            {{#isGimbalRotateAction}}
                            <wpml:payloadPositionIndex>{{actionPayloadPositionIndex}}</wpml:payloadPositionIndex>
                            <wpml:gimbalHeadingYawBase>{{actionGimbalHeadingYawBase}}</wpml:gimbalHeadingYawBase>
                            <wpml:gimbalRotateMode>{{actionGimbalRotateMode}}</wpml:gimbalRotateMode>
                            <wpml:gimbalPitchRotateEnable>{{actionGimbalPitchRotateEnable}}</wpml:gimbalPitchRotateEnable>
                            <wpml:gimbalPitchRotateAngle>{{actionGimbalPitchRotateAngle}}</wpml:gimbalPitchRotateAngle>
                            <wpml:gimbalRollRotateEnable>{{actionGimbalRollRotateEnable}}</wpml:gimbalRollRotateEnable>
                            <wpml:gimbalRollRotateAngle>{{actionGimbalRollRotateAngle}}</wpml:gimbalRollRotateAngle>
                            <wpml:gimbalYawRotateEnable>{{actionGimbalYawRotateEnable}}</wpml:gimbalYawRotateEnable>
                            <wpml:gimbalYawRotateAngle>{{actionGimbalYawRotateAngle}}</wpml:gimbalYawRotateAngle>
                            <wpml:gimbalRotateTimeEnable>{{actionGimbalRotateTimeEnable}}</wpml:gimbalRotateTimeEnable>
                            <wpml:gimbalRotateTime>{{actionGimbalRotateTime}}</wpml:gimbalRotateTime>
                            {{/isGimbalRotateAction}}
                            {{#isGimbalEvenlyRotateAction}}
                            <wpml:payloadPositionIndex>{{actionPayloadPositionIndex}}</wpml:payloadPositionIndex>
                            <wpml:gimbalPitchRotateAngle>{{actionGimbalPitchRotateAngle}}</wpml:gimbalPitchRotateAngle>
                            {{/isGimbalEvenlyRotateAction}}
                            {{#isRotateYawAction}}
                            <wpml:aircraftHeading>{{actionAircraftHeading}}</wpml:aircraftHeading>
                            <wpml:aircraftPathMode>{{actionAircraftPathMode}}</wpml:aircraftPathMode>
                            {{/isRotateYawAction}}
                            {{#isHoverAction}}
                            <wpml:hoverTime>{{actionHoverTime}}</wpml:hoverTime>
                            {{/isHoverAction}}
                        </wpml:actionActuatorFuncParam>
                    </wpml:action>
                    {{/actionGroupActions}}
                </wpml:actionGroup>
                {{/waypointActionGroups}}
            </Placemark>
            {{/waypoints}}
        </Folder>
    </Document>
</kml>